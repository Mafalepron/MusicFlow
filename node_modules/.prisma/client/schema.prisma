generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedGroups      Group[]        @relation("GroupOwner")
  groupMemberships GroupMember[]
  ideas            Idea[]
  tracks           Track[]
  comments         Comment[]
  trackVersions    TrackVersion[]
  messages         Message[]
  notifications    Notification[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  genre       String?
  inviteCode  String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members  GroupMember[]
  projects Project[]
  ideas    Idea[]
}

model GroupMember {
  groupId    String
  userId     String
  role       String   @default("member") // 'owner', 'producer', 'musician', 'guest'
  instrument String?
  joinedAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Project {
  id        String   @id @default(cuid())
  groupId   String
  title     String
  type      String   @default("single") // 'album', 'ep', 'single'
  coverUrl  String?
  status    String   @default("draft") // 'draft', 'in_progress', 'mixing', 'mastering', 'released'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tracks        Track[]
  ideas         Idea[]         @relation("IdeaProject")
  notifications Notification[]

  @@index([groupId])
}

model Idea {
  id          String   @id @default(cuid())
  groupId     String
  createdBy   String
  title       String
  description String?
  audioUrl    String?
  waveformUrl String?
  durationMs  Int?
  tags        String? // JSON array stored as string
  projectId   String? // If moved to a project
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User     @relation(fields: [createdBy], references: [id])
  project       Project? @relation("IdeaProject", fields: [projectId], references: [id], onDelete: SetNull)
  derivedTracks Track[]  @relation("TrackIdea")

  @@index([groupId])
  @@index([projectId])
}

model Track {
  id           String   @id @default(cuid())
  projectId    String
  sourceIdeaId String?
  title        String
  trackNumber  Int?
  audioUrl     String
  waveformUrl  String?
  durationMs   Int?
  status       String   @default("recording") // 'idea', 'recording', 'mixing', 'final'
  version      Int      @default(1)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceIdea Idea?          @relation("TrackIdea", fields: [sourceIdeaId], references: [id])
  creator    User           @relation(fields: [createdBy], references: [id])
  versions   TrackVersion[]
  comments   Comment[]

  @@index([projectId])
}

model TrackVersion {
  id         String   @id @default(cuid())
  trackId    String
  version    Int
  label      String   @default("")
  audioUrl   String
  durationMs Int?
  createdBy  String
  createdAt  DateTime @default(now())

  track    Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id])
  comments Comment[]

  @@unique([trackId, version])
  @@index([trackId])
}

model Comment {
  id          String   @id @default(cuid())
  trackId     String
  versionId   String?
  parentId    String?
  userId      String
  timestampMs Int
  rangeEndMs  Int?
  text        String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  track   Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  version TrackVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")

  @@index([trackId])
  @@index([versionId])
  @@index([parentId])
}

model Message {
  id         String   @id @default(cuid())
  entityType String // 'project' or 'track'
  entityId   String
  userId     String
  text       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // 'chat_message' | 'comment' | 'track_version'
  entityId  String // ID of the entity (message, comment, or track)
  projectId String
  title     String // e.g. "New comment on Main Track"
  body      String? // e.g. "Alex: Great take!"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
